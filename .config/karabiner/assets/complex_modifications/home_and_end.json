{
  "title": "HomeキーとEndキー",
  "rules": [
    {
      "description": "HomeキーをCommand+←にする",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "home",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": {
            "key_code": "left_arrow",
            "modifiers": [
              "command"
            ]
          }
        }
      ]
    },
    {
      "description": "EndキーをCommand+→にする",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "end",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": {
            "key_code": "right_arrow",
            "modifiers": [
              "command"
            ]
          }
        }
      ]
    }
  ]
}
